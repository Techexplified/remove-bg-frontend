{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2017"],
    "typeRoots": ["./node_modules/@figma", "./node_modules/@types"],
    "outDir": "dist",
    "rootDir": "src-plugin",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src-plugin/**/*.ts"]
}
